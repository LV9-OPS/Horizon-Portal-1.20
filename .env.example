HORIZON_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=
HORIZON_ADMIN_PASSWORD=
HORIZON_ROTATE_ADMIN_PASSWORD=0
WORKSHOP_QUARANTINE_DIR=
CLAMSCAN_PATH=

# Persistent S3-compatible Workshop storage (Cloudflare R2, AWS S3, MinIO, etc.).
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_QUARANTINE_BUCKET=
S3_PUBLIC_BUCKET=
WORKSHOP_PUBLIC_BASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins allowed to call the API cross-origin.
HORIZON_WEB_ORIGINS=https://horizon-portal-lv-8-e7ea.vercel.app
# Temporary bridge URL for the current Windows launcher until V1.0 is released.
PUBLIC_LAUNCHER_DOWNLOAD_URL=https://horizon-portal-lv-8-e7ea.vercel.app/static/downloads/Horizon%20Manager_0.9.1_x64-setup.exe
